# Google Gemini API Key (https://aistudio.google.com/ 에서 발급)
GEMINI_API_KEY=your_gemini_api_key_here

# 사용할 Gemini 모델명 (예: gemini-2.5-flash, gemini-2.0-flash 등)
GEMINI_MODEL=gemini-3.5-flash-lite

# 사이트 무단 접속 방지용 비밀번호 (설정하지 않으면 기본값 '1234' 적용)
SITE_PASSWORD=1234

# Flask 세션 암호화 키 (임의의 긴 무작위 문자열 권장)
SECRET_KEY=data-insight-builder-secure-session-key-2026

# Flask 디버그 모드 여부 (true / false)
FLASK_DEBUG=false

# 최대 CSV 업로드 허용 크기 (MB 단위)
MAX_UPLOAD_MB=10
